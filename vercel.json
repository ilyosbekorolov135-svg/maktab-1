{
  "buildCommand": "npx prisma generate && vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": ["node_modules/.prisma/client/**", "prisma/schema.prisma"]
    },
    "api/[...path].ts": {
      "maxDuration": 30,
      "includeFiles": ["node_modules/.prisma/client/**", "prisma/schema.prisma"]
    }
  }
}
